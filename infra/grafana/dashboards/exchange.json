  "panels": [
    {
      "title": "Missing instrumentation / refusal coverage",
      "type": "text",
      "options": {
        "mode": "markdown",
        "content": "**Submitted and accepted orders: not instrumented. Tick-to-fill latency: not instrumented.** [Follow-up #111](https://github.com/Suddha-Abhitej/SimEx/issues/111) prioritises counters (a refusal denominator) and tracks the larger matching-path histogram. Rejection counts alone are not a refusal fraction. These panels count writer-emitted rejections, including effect-time failures; early request-validation refusals are visible only to the requesting client. Journal eviction can undercount them; see the gap panel. No trading-path instrumentation is added here."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      }
    },
    {
      "title": "Writer rejections per second, by reason",
      "type": "timeseries",
      "description": "Stable reason prefixes, not changing age suffixes. This is a count rate, not rejected/submitted. It excludes early request-validation refusals.",
      "datasource": {
        "type": "prometheus",
        "uid": "simex-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "simex-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (product_id, reason) (rate(simex_exchange_rejections_total[$__rate_interval]))",
          "legendFormat": "{{product_id}} / {{reason}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "title": "Gate open (1 = open, 0 = closed)",
      "type": "timeseries",
      "description": "Feed safety guard. A missing series is unavailable, not open. Prometheus alerts: ExchangeGateClosedTooLong.",
      "datasource": {
        "type": "prometheus",
        "uid": "simex-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "simex-prometheus"
          },
          "editorMode": "code",
          "expr": "simex_exchange_gate_state{state=\"open\"}",
          "legendFormat": "{{product_id}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
