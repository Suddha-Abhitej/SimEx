    {
      "title": "Late records (last 10 minutes)",
      "type": "timeseries",
      "description": "Ordering margin lost, not a dropped record. The Prometheus rule alerts above 20 across products in ten minutes. Prometheus alerts: ExchangeLateRecords.",
      "datasource": {
