# Copy to .env for local development. Never commit .env.
# compose.yaml and scripts/smoke_test.py both read these; the defaults match the values below.

# Postgres
POSTGRES_USER=simex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=simex

# Grafana (only started with: docker compose --profile monitoring up -d)
GRAFANA_ADMIN_PASSWORD=change-me

# Host ports, all bound to 127.0.0.1. Change one if it clashes with something on your machine.
KAFKA_PORT=9092
POSTGRES_PORT=5432
VALKEY_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Market-data ingestor (python -m simex.ingest), ADR 0010 and 0011
# gemini = the live venue (publishes md.*). coinbase = feed research only: it also needs
# SIMEX_COINBASE_RESEARCH=1 and publishes to research.coinbase.md.*, never md.*.
SIMEX_VENUE=gemini
SIMEX_COINBASE_RESEARCH=0
# Normalized product IDs; adapters map them (BTC-USD -> btcusd on Gemini)
SIMEX_PAIRS=BTC-USD,ETH-USD,SOL-USD
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
INGEST_METRICS_PORT=9101
# Reconnect after this long without a level2 message, ping reply or control frame. Trades never
# count: Gemini pairs can go minutes without one (longest level2 silence measured: 1 s)
INGEST_STALE_AFTER_SECONDS=5
# Gemini has no heartbeats channel: ping this often (must be well under the stale window)
INGEST_PING_INTERVAL_SECONDS=2
INGEST_BACKOFF_INITIAL_SECONDS=1
INGEST_BACKOFF_MAX_SECONDS=60
# Gap resync (ADR 0008): at most one level2 resubscribe per interval; reconnect if a
# resubscribe hasn't delivered every snapshot within the timeout
INGEST_RESYNC_MIN_INTERVAL_SECONDS=5
INGEST_RESYNC_TIMEOUT_SECONDS=10
# Log an error when real gaps exceed this per minute (sequence semantics may have changed)
INGEST_GAP_ALERT_PER_MINUTE=10
# Snapshot refresh (ADR 0009): resync one product's level2 at a time so every product gets a
# fresh snapshot this often (staggered: interval / number of pairs apart). 0 = off.
INGEST_SNAPSHOT_REFRESH_SECONDS=1800
# Book audit (ADR 0012): ask the venue for one product's top 100 levels a side every
# INGEST_AUDIT_SECONDS / number of pairs, so each product is audited this often. 0 = off.
INGEST_AUDIT_SECONDS=120
# How long an audit that arrived before its matching diff is held before it's published unaligned.
INGEST_AUDIT_HOLD_SECONDS=2
# md.level2 retention, applied at startup; hours must be >= 2x the refresh interval.
# Bytes are per partition; -1 = no size limit.
INGEST_LEVEL2_RETENTION_HOURS=24
INGEST_LEVEL2_RETENTION_BYTES=2147483648
# DEV ONLY fault injector: drop every Nth received message to force gaps. 0 = off. Never in prod.
SIMEX_INGEST_DROP_EVERY=0
INGEST_TOPIC_PARTITIONS=3
INGEST_TOPIC_REPLICATION_FACTOR=1
GEMINI_WS_URL=wss://ws.gemini.com?snapshot=-1
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# Order book service (python -m simex.book), ADR 0012. Reads md.level2 from
# 2 x INGEST_SNAPSHOT_REFRESH_SECONDS ago and publishes simex:book:gemini:<pair> to Valkey.
BOOK_METRICS_PORT=9102
# Levels per side in each Valkey record, how often it is written, and its TTL
BOOK_PUBLISH_DEPTH=10
BOOK_PUBLISH_INTERVAL_SECONDS=0.25
BOOK_PUBLISH_TTL_SECONDS=2
# Defaults to redis://127.0.0.1:${VALKEY_PORT}/0
VALKEY_URL=

# Recorder (python -m simex.recorder), ADR 0013. md.level2, md.trades and md.gaps to hourly
# zstd Parquet under RECORDER_ROOT; data/ is gitignored and never committed (ADR 0010).
RECORDER_ROOT=data/recordings
RECORDER_METRICS_PORT=9103
RECORDER_GROUP_ID=simex-recorder
# Days kept locally. With RECORDER_REQUIRE_ARCHIVED=1, an expired day is only deleted once the
# nightly copy to the home server has written date=.../_ARCHIVED (that script comes later).
RECORDER_RETENTION_DAYS=30
RECORDER_REQUIRE_ARCHIVED=0
# Row groups are written this often (or at this many bytes) while an hour's file is open; a file
# is closed this long after its hour ends even if no later record came.
RECORDER_ROW_GROUP_SECONDS=300
RECORDER_ROW_GROUP_BYTES=8388608
RECORDER_HOUR_GRACE_SECONDS=60

# Exchange core (simex.exchange), ADR 0014. Fees default to Gemini's API/ActiveTrader entry tier
# (30-day volume >= $0, schedule dated 2026-09-01): 60 bps maker, 120 bps taker.
EXCHANGE_MAKER_FEE_BPS=60
EXCHANGE_TAKER_FEE_BPS=120
# How far a market order may walk from the best price; per pair with a suffix, e.g.
# EXCHANGE_MARKET_BAND_BPS_SOL_USD=80
EXCHANGE_MARKET_BAND_BPS=50
# Fill simulator: W, how long a level shrink waits for the print that explains it (measured from
# the recordings with tools/measure_fill_window.py, ADR 0014; per pair with a suffix, e.g.
# EXCHANGE_MATCH_WINDOW_MS_ETH_USD=500); how long "we took X here" is remembered; and how cancels
# move a resting order's queue (proportional, pessimistic or optimistic).
EXCHANGE_MATCH_WINDOW_MS=300
EXCHANGE_DEPLETION_MAX_AGE_SECONDS=10
EXCHANGE_CANCEL_ATTRIBUTION=proportional
# What a cross does (the venue's other side reaching a resting order's price): print (the
# default; it puts the order first in the queue, and only prints fill it) or fill (the optimistic
# bracket: the crossing liquidity fills it).
EXCHANGE_BOOK_CROSS=print
# Fixed anti-cheat delay applied to both orders and cancels.
EXCHANGE_ORDER_DELAY_MS=200
# Stale-data guard (#9): receive-clock level2 age, rolling lag excess and absolute lag backstop.
EXCHANGE_STALE_AFTER_MS=5000
EXCHANGE_MAX_EXCESS_LAG_MS=2000
EXCHANGE_MAX_ABS_LAG_MS=30000
EXCHANGE_LAG_BASELINE_MINUTES=10
# Live exchange runner (python -m simex.exchange), ADR 0015: metrics port; the merge's hold-back
# (a caught-up partition holds everything received this long before it was seen caught up); the
# consumer's fetch wait (it adds to the watermark lag); the release-order digests.
EXCHANGE_METRICS_PORT=9104
EXCHANGE_MERGE_HOLDBACK_MS=250
EXCHANGE_FETCH_MAX_WAIT_MS=20
EXCHANGE_DIGEST_PATH=data/exchange/merge-digests.jsonl
LOG_LEVEL=INFO
