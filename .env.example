# Copy to .env for local development. Never commit .env.
# compose.yaml and scripts/smoke_test.py both read these; the defaults match the values below.

# Postgres
POSTGRES_USER=simex
POSTGRES_PASSWORD=change-me
POSTGRES_DB=simex

# Grafana (only started with: docker compose --profile monitoring up -d)
GRAFANA_ADMIN_PASSWORD=change-me

# Host ports, all bound to 127.0.0.1. Change one if it clashes with something on your machine.
KAFKA_PORT=9092
POSTGRES_PORT=5432
VALKEY_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Coinbase ingestor (python -m simex.ingest)
SIMEX_PAIRS=BTC-USD,ETH-USD,SOL-USD
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
INGEST_METRICS_PORT=9101
# Reconnect when no message (heartbeats arrive every second) has arrived for this long
INGEST_STALE_AFTER_SECONDS=10
INGEST_BACKOFF_INITIAL_SECONDS=1
INGEST_BACKOFF_MAX_SECONDS=60
INGEST_TOPIC_PARTITIONS=3
INGEST_TOPIC_REPLICATION_FACTOR=1
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
LOG_LEVEL=INFO
